engine-strict=true

# Supply-chain cooldown: never install an npm package version published less
# than this many days ago. A deliberate same-day update is a one-shot
# override: npm_config_min_release_age=0 npm install
min-release-age=30
allow-git=none
allow-remote=root
allow-file=none
allow-directory=none

# BSU packages come from the GitHub Packages registry. CI authenticates with
# its workflow GITHUB_TOKEN; people need a classic PAT with read:packages in
# ~/.npmrc (see CONTRIBUTING.md).
@bemidjistate:registry=https://npm.pkg.github.com
